MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=booknest
MYSQL_USER=booknest
MYSQL_PASSWORD=change_me

# Generate with: openssl rand -hex 32
# The placeholder is deliberately short. Our schema will require at least 32 characters, so if someone copies this file without changing it, the app refuses to start. 
# A longer, nicer-looking placeholder would pass validation, and a publicly known secret would let anyone forge tokens.
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_ISSUER=booknest